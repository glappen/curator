<dl class="retrieval-detail__snapshot-list">
  <dt>Chat model</dt>
  <dd><%= retrieval.chat_model || "—" %></dd>

  <dt>Embedding model</dt>
  <dd><%= retrieval.embedding_model || "—" %></dd>

  <dt>Retrieval strategy</dt>
  <dd><%= retrieval.retrieval_strategy || "—" %></dd>

  <dt>Similarity threshold</dt>
  <dd><%= retrieval.similarity_threshold || "—" %></dd>

  <dt>Chunk limit</dt>
  <dd><%= retrieval.chunk_limit || "—" %></dd>

  <dt>Strict grounding</dt>
  <dd><%= retrieval.strict_grounding.nil? ? "—" : retrieval.strict_grounding %></dd>

  <dt>Include citations</dt>
  <dd><%= retrieval.include_citations.nil? ? "—" : retrieval.include_citations %></dd>

  <dt>System prompt hash</dt>
  <dd><code><%= retrieval.system_prompt_hash || "—" %></code></dd>

  <dt>Total duration</dt>
  <dd><%= retrieval.total_duration_ms ? "#{retrieval.total_duration_ms} ms" : "—" %></dd>

  <% if retrieval.system_prompt_override.present? %>
    <dt>Operator override</dt>
    <dd>
      <pre class="retrieval-detail__snapshot-prompt"><%= retrieval.system_prompt_override %></pre>
    </dd>
  <% end %>

  <%# Re-derive the assembled prompt the LLM saw by passing the persisted
      hits + the operator override (if any) back through the Assembler.
      This avoids storing the multi-KB rendered output on every retrieval
      row but preserves the audit-trail UI. The hash above lets an SME
      spot drift if the KB's default instructions have changed since the
      original retrieval. %>
  <% if hits.any? %>
    <% kb_for_assembly = retrieval.knowledge_base
       if retrieval.system_prompt_override.present?
         kb_for_assembly = retrieval.knowledge_base.dup
         kb_for_assembly.system_prompt = retrieval.system_prompt_override
       end
       assembled = Curator::Prompt::Assembler.new.call(kb: kb_for_assembly, hits: hits) %>
    <dt>Assembled prompt</dt>
    <dd>
      <pre class="retrieval-detail__snapshot-prompt"><%= assembled[:system_prompt_text] %></pre>
    </dd>
  <% end %>
</dl>
